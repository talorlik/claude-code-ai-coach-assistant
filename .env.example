# Example environment configuration. Copy to `.env.local` and fill in real
# values. NEVER commit real secrets - `.env.local` is gitignored.

# --- Supabase ---------------------------------------------------------------
# Browser-safe project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (admin client). Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (Vercel AI Gateway) --------------------------------------------------
# Server-only key for the Vercel AI Gateway. Never expose to the browser.
AI_GATEWAY_API_KEY=

# --- Turnstile captcha -------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Web Push (workout reminders) -------------------------------------------
# Generate a VAPID key pair once with:  npx web-push generate-vapid-keys
# The public key is browser-safe (sent with the subscription); the private key
# is a server-only secret used to sign push messages.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service (mailto: or https URL). Defaults to the admin.
VAPID_SUBJECT=mailto:talorlik@gmail.com
# Shared secret for the reminder cron trigger. Sent as `Bearer <CRON_SECRET>`
# by Vercel Cron; manual triggers use a trainer-admin session instead.
CRON_SECRET=
